{
  "name": "@beta/marker-site",
  "version": "0.8.0",
  "private": true,
  "description": "Static launch website for BETA Cutting Room (offline, no trackers, no CDN)",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node --disable-warning=ExperimentalWarning src/build.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --root ../../.. marker/apps/site",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": ">=22.18.0"
  }
}
