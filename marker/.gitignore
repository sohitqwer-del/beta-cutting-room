# Build output
target/
pkg/
node_modules/
dist/

# Third-party clones and large datasets: never commit
vendor/
bench/data/
bench/out/

# User-supplied factory patterns and markers stay private by default
private-patterns/
*.private.*

# Local outputs
out/
*.log

# Demo video for the website: copied in before a site build, never committed (see deploy/video/README.md)
apps/site/public/assets/video/*.mp4
